# The always-on machine (never woken, never slept by the dispatcher).
PRIMARY_URL=http://192.168.1.10:11434
PRIMARY_MODEL=qwen3.5:9b

# The wakeable machine (e.g. a gaming PC that sleeps). Woken via
# Wake-on-LAN when a request routes to it and it is not answering.
SECONDARY_URL=http://192.168.1.20:11434
SECONDARY_MODEL=qwen3:14b
SECONDARY_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCASTS=192.168.1.255,255.255.255.255

# Model families pinned to one machine (comma-separated prefixes).
PRIMARY_MODEL_PREFIXES=qwen2.5-coder
SECONDARY_MODEL_PREFIXES=qwen3:14b

# Role aliases: what brain/heavy/coder/utility resolve to.
ROLE_BRAIN=qwen3.5:9b
ROLE_HEAVY=qwen3.6:35b-a3b
ROLE_CODER=qwen3-coder:30b
ROLE_UTILITY=qwen3.5:4b

# Mode state file (persist this path if you want the mode to survive
# restarts) and the dev-mode auto-expiry.
MODE_FILE=/data/mode
DEV_TTL_HOURS=8
WAKE_TIMEOUT=150
